JWT_SECRET=change_me_to_a_random_secret
PORT=3001

# Turso (libSQL) — free hosted SQLite-compatible database. Create one at
# https://turso.tech, then run `turso db show <db-name> --url` and
# `turso db tokens create <db-name>` to get these two values.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
